{
  "info": {
    "_postman_id": "c6a1e5df-4d65-4f45-983b-9bb936a5ea99",
    "name": "Restaurant gRPC & Web App",
    "description": "Essential REST CRUD endpoints for Restaurant gRPC Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "menu_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Get All Menu Items",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var res = pm.response.json();",
              "if (res.data && res.data.length > 0) {",
              "    pm.environment.set(\"menu_id\", res.data[0].id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/menu",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "menu"
          ]
        },
        "description": "Fetch all menu items. Automatically saves the first item's ID into the environment variable 'menu_id'."
      },
      "response": []
    },
    {
      "name": "2. Get Menu Item By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/menu/{{menu_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "menu",
            "{{menu_id}}"
          ]
        },
        "description": "Fetch a single menu item by ID using {{menu_id}}."
      },
      "response": []
    },
    {
      "name": "3. Create Menu Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var res = pm.response.json();",
              "if (res.data && res.data.id) {",
              "    pm.environment.set(\"menu_id\", res.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Green Curry\",\n  \"price\": 150\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/menu",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "menu"
          ]
        },
        "description": "Create a new menu item. Automatically saves the new item's ID into {{menu_id}}."
      },
      "response": []
    },
    {
      "name": "4. Update Menu Item",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Green Curry Special\",\n  \"price\": 180\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/menu/{{menu_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "menu",
            "{{menu_id}}"
          ]
        },
        "description": "Update name and price for the menu item referenced by {{menu_id}}."
      },
      "response": []
    },
    {
      "name": "5. Delete Menu Item",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/menu/{{menu_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "menu",
            "{{menu_id}}"
          ]
        },
        "description": "Delete the menu item referenced by {{menu_id}} from MongoDB."
      },
      "response": []
    }
  ]
}
